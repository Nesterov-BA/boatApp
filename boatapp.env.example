# Пример файла окружения boatapp.env
# ---------------------------------------------------------------------------
# Чтобы программа использовала базу данных на сервере:
#   1) Скопируйте этот файл рядом с приложением под именем boatapp.env
#      (или укажите путь через переменную BOATAPP_ENV_FILE).
#   2) Раскомментируйте нужную строку и подставьте свои параметры.
# Файл boatapp.env читается при каждом запуске, пароль никуда не логируется.
# ---------------------------------------------------------------------------

# PostgreSQL (сначала установите драйвер:  uv add "psycopg[binary]")
# BOATAPP_DB_URL=postgresql+psycopg://имя_пользователя:пароль@хост:5432/имя_бд

# MySQL или MariaDB (сначала установите драйвер:  uv add pymysql)
# BOATAPP_DB_URL=mysql+pymysql://имя_пользователя:пароль@хост:3306/имя_бд?charset=utf8mb4

# Локальный файл SQLite (по умолчанию, можно указать явно свой путь)
# BOATAPP_DB=C:/Data/boatapp.db

# Проверка подключения из терминала:
#   uv run python main.py --check-db
